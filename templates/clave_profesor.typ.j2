// Plantilla Typst para Clave del Profesor (alucarD)
#set document(title: "{{ definicion.nombre_examen }} - Clave Tema {{ tema + 1 }}", author: "Cátedra")
#set page(
  paper: "a4",
  margin: (top: {{ estilo.margen_sup_mm }}mm, bottom: 2cm, left: 2cm, right: 2cm),
  header: context [
    {% if estilo.logo_typst %}#let logo = {{ estilo.logo_typst }}
    {% endif %}#{{ estilo.encabezado_typst }}
  ],
  footer: context [
    #line(length: 100%, stroke: 0.5pt + rgb("{{ c.linea_pie }}"))
    #{{ estilo.pie_typst }}
  ]
)

#set text(font: {{ estilo.fuente_typst }}, size: {{ estilo.tamano }}pt, lang: "{{ definicion.idioma | default('es') }}"{% if estilo.alto_contraste %}, fill: black{% endif %})
#show raw: set text(font: {{ estilo.fuente_codigo_typst }})
{% if estilo.alto_contraste %}
// Alto contraste: el código, sin el gris de los comentarios del resaltado
#show raw: set text(fill: black)
#set raw(theme: none)
{% endif %}
#set par(justify: true, leading: 0.65em)

#align(center)[
  #block(fill: rgb("fff5f5"), inset: 10pt, radius: 4pt, stroke: 1pt + rgb("feb2b2"))[
    #text(size: 15pt, weight: "bold", fill: rgb("9b2c2c"))[CLAVE DE CORRECCIÓN — TEMA {{ tema + 1 }}]\
    #v(2pt)
    #text(size: 10pt, fill: rgb("742a2a"))[{{ [definicion.nombre_examen, definicion.materia] | select | map("typst_texto") | join(" — ") }}]
  ]
]

#v(10pt)

{% for seccion in secciones %}
#text(size: 11pt, weight: "bold", fill: rgb("{{ c.seccion }}"))[{{ seccion.nombre | typst_texto }}]
#v(4pt)

{% for preg in seccion.preguntas %}
#block(
  width: 100%,
  stroke: 0.5pt + rgb("{{ c.borde }}"),
  radius: 4pt,
  inset: 6pt,
  fill: rgb("fafafa"),
  breakable: {{ 'true' if preg.tipo == 'consigna_practica' else 'false' }}
)[
  #text(weight: "bold")[{{ loop.index }}. {{ preg.nombre | typst_texto }}]
  #v(2pt)
  {% set correctas = [] %}
  {% for op in preg.opciones %}{% if op.es_correcta %}{% set _ = correctas.append(loop.index0) %}{% endif %}{% endfor %}
  {% if preg.tipo == 'consigna_practica' %}
  {% if preg.metadata.solucion_c_clave %}
  #raw(block: true, lang: "c", {{ preg.metadata.solucion_c_clave | typst_cadena }})
  {% else %}
  #text(fill: rgb("22543d"), weight: "bold")[✓ Respuesta:] Ver criterio de corrección
  {% endif %}
  {% elif correctas %}
  {% for i in correctas %}
  #text(fill: rgb("22543d"), weight: "bold")[✓ {{ letra(i) }})] {{ preg.opciones[i].texto_html | typst }}
  {% endfor %}
  {% else %}
  #text(fill: rgb("22543d"), weight: "bold")[✓ Respuesta:] Ver criterio de corrección
  {% endif %}
  {% if preg.retroalimentacion_general %}
  \ #text(fill: rgb("{{ c.sub }}"), size: 8.5pt)[*Explicación:* {{ preg.retroalimentacion_general | typst }}]
  {% endif %}
]
#v(4pt)
{% endfor %}
#v(6pt)
{% endfor %}
