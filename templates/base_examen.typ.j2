// Plantilla Typst para Examen Teórico (alucarD)
{% set margen_inf = omr.margen_inf_mm if omr else 20 %}
{% if omr %}
// Carátula OMR (OMR_SPEC.md): la franja de la página 1 sale del manifiesto, leído con json().
{{ omr.modulo }}
#let omr-m = json({{ omr.manifiesto | typst_cadena }})
// El QR de pie de cada página desde la 2: EXAM_ID/STUDENT_ID/P<n>.
#let omr-pies = ({% for n, svg in omr.pies.items() %}"{{ n }}": {{ svg | typst_cadena }}, {% else %}:{% endfor %})
{% endif %}
#set document(title: "{{ definicion.nombre_examen }} - Tema {{ tema + 1 }}", author: "{{ definicion.institucion }}")
#set page(
  paper: "a4",
  background: {% if omr %}context {
    // La franja va desde el origen de la página, fuera de los márgenes: A4 exacto, sin escala.
    if counter(page).get().first() == 1 {
      place(top + left, omr-franja(omr-m, ox: {{ omr.ox_mm }}mm, oy: {{ omr.oy_mm }}mm, divisoria: {{ omr.divisoria_mm }}mm,
        qr: (svg: {{ omr.qr | typst_cadena }}, x: {{ omr.qr_x }}, y: {{ omr.qr_y }}, lado: {{ omr.qr_lado }}),
        respaldo: ({% for linea in omr.respaldo %}{{ linea | typst_cadena }}, {% endfor %}),
        texto: (x: {{ omr.texto_x }}, y: {{ omr.texto_y }}, ancho: {{ omr.texto_ancho }})))
    }{% if definicion.configuracion_examen.debug_consignas %}
    place(center + horizon, rotate(-45deg, text(size: 120pt, weight: "bold", fill: luma(225))[Debug])){% endif %}
  }{% elif definicion.configuracion_examen.debug_consignas %}rotate(-45deg, text(size: 120pt, weight: "bold", fill: luma(225))[Debug]){% else %}none{% endif %},
  margin: (top: {{ estilo.margen_sup_mm }}mm, bottom: {{ margen_inf }}mm, left: 2cm, right: 2cm),
  header: context {
    let hoja = counter(page).get().first()
    // Con carátula OMR, la página 1 no lleva encabezado: arriba está la franja.
    if {{ 'hoja > 1' if omr else 'true' }} [
    {% if estilo.logo_typst %}#let logo = {{ estilo.logo_typst }}
    {% endif %}#{{ estilo.encabezado_typst }}
    {% if estilo.nombre_en_hojas %}
    // Cada hoja nueva (las páginas impares, salvo la primera, que tiene el cuadro de datos) lleva
    // un renglón para el nombre: si las hojas se separan, se sabe de quién es cada una.
    #if hoja > 1 and calc.odd(hoja) [
      #v(1.5mm, weak: true)
      #text(size: 9pt)[*Apellido y Nombre:* {% if omr %}{{ omr.nombre | typst_texto }}{% else %}#box(width: 1fr, line(length: 100%, stroke: 0.5pt)){% endif %}]
    ]
    {% endif %}
    ]
  },
  footer: context [
    {% if omr %}
    #let hoja = counter(page).get().first()
    #grid(columns: (1fr, {{ omr.pie_lado }}mm), column-gutter: 4mm, align: horizon,
      [
        #line(length: 100%, stroke: 0.5pt + rgb("{{ c.linea_pie }}"))
        #{{ estilo.pie_typst }}
      ],
      if hoja > 1 and str(hoja) in omr-pies {
        image(bytes(omr-pies.at(str(hoja))), format: "svg", width: {{ omr.pie_lado }}mm, height: {{ omr.pie_lado }}mm)
      } else { box(width: {{ omr.pie_lado }}mm) })
    {% else %}
    #line(length: 100%, stroke: 0.5pt + rgb("{{ c.linea_pie }}"))
    #{{ estilo.pie_typst }}
    {% endif %}
  ]
)

#set text(font: {{ estilo.fuente_typst }}, size: {{ estilo.tamano }}pt, lang: "{{ definicion.idioma | default('es') }}"{% if estilo.alto_contraste %}, fill: black{% endif %})
#show raw: set text(font: {{ estilo.fuente_codigo_typst }})
{% if estilo.alto_contraste %}
// Alto contraste: el código, sin el gris de los comentarios del resaltado
#show raw: set text(fill: black)
#set raw(theme: none)
{% endif %}
#set par(justify: true, leading: 0.65em)

// Lo que el layout no puede acomodar queda en una marca <desborde>, y alucard lo avisa al terminar.
#let pregunta-actual = state("pregunta-actual", "")
#let avisar(motivo, nombre: none) = context [
  #metadata((pregunta: if nombre == none { pregunta-actual.get() } else { nombre }, motivo: motivo)) <desborde>
]
#let vigilar(it, motivo, cabe) = place(layout(lugar => if not cabe(lugar.width) { avisar(motivo) })) + it
#show raw.where(block: true): it => vigilar(it, "un renglón de código no entra en el ancho y se parte",
  ancho => measure(it).width <= ancho)
#show math.equation.where(block: true): it => vigilar(it, "una fórmula se sale del ancho de la página",
  ancho => measure(it).width <= ancho)

// El espacio para responder: renglones de 16pt, los mismos de las consignas prácticas. `alto` es una
// longitud absoluta, porque hay que saber cuántos entran.
#let espacio(alto) = {
  let filas = calc.max(1, calc.floor(alto / 16pt))
  rect(width: 100%, height: filas * 16pt, inset: (x: 6pt, y: 0pt),
       stroke: (dash: "densely-dotted", paint: rgb("{{ c.guia }}"), thickness: 0.5pt))[
    #for _ in range(filas - 1) {
      block(width: 100%, height: 16pt, above: 0pt, below: 0pt,
            stroke: (bottom: (dash: "dotted", paint: rgb("{{ c.guia }}"), thickness: 0.5pt)))
    }
    #place(bottom + right, dy: -2pt)[#text(size: 0.75em, fill: rgb("{{ c.guia }}"))[Espacio para desarrollo / código]]
  ]
}

// Una pregunta entra entera en una página. Sólo se corta por sus marcas `// [corte]` y, si no entra
// en una página, por sus encabezados y antes de las opciones. Una parte que tampoco entra se parte
// por donde toque: encimar el texto sería peor. `hoja`: el resto de la hoja queda para responder.
// La hoja se mide desde una marca anterior a la pregunta: medir desde la pregunta la llevaría a la
// página siguiente, donde esa medida también cierra, y dejaría vacía la anterior.
#let pregunta(partes, libre: false, hoja: false, nombre: "") = {
  if hoja { block(height: 0pt, above: 0pt, below: 0pt)[#metadata(none) <antes-de-la-hoja>] }
  context {
  let alto = page.height - {{ estilo.margen_sup_mm }}mm - {{ margen_inf }}mm
  let ancho = page.width - 4cm
  let caja(rompible, cuerpo) = block(
    width: 100%,
    stroke: 0.5pt + rgb("{{ c.borde }}"),
    radius: 4pt,
    inset: 8pt,
    fill: {% if definicion.configuracion_examen.debug_consignas %}none{% else %}rgb("ffffff"){% endif %},  // la marca de agua va debajo
    breakable: rompible,
    cuerpo
  )
  let alto-de(cuerpo) = measure(block(width: ancho, caja(false, cuerpo))).height
  let todo = partes.map(p => p.at(1)).join(parbreak())
  let total = alto-de(todo)
  let cuadro = if hoja {
    let inicio = query(selector(<antes-de-la-hoja>).before(here())).last().location().position().y
    let libre-en-hoja = page.height - {{ margen_inf }}mm - inicio - calc.rem-euclid(total / 1pt, alto / 1pt) * 1pt
    espacio(calc.max(60pt / 1pt, libre-en-hoja / 1pt - 40) * 1pt)
  }
  if libre {
    caja(true, todo)
  } else {
    let grande = total > alto
    let grupos = ()
    for (marca, cuerpo) in partes {
      if grupos.len() == 0 or marca or grande {
        grupos.push(cuerpo)
      } else {
        grupos.push(grupos.pop() + parbreak() + cuerpo)
      }
    }
    let entera(cuerpo) = {
      let no-entra = alto-de(cuerpo) > alto
      if no-entra { avisar("una parte no entra en una página y se parte por donde toque", nombre: nombre) }
      block(width: 100%, breakable: no-entra, cuerpo)
    }
    caja(grupos.len() > 1 or grande, grupos.map(entera).join() + cuadro)
  }
  }
}

{% if omr %}
// El cuerpo empieza debajo de la línea divisoria de la franja: nunca la invade.
#v({{ omr.salto_mm }}mm)
{% endif %}
// Encabezado del Examen
#align(center)[
  #text(size: 1.6em, weight: "bold", fill: rgb("{{ c.titulo }}"))[{{ definicion.nombre_examen | typst_texto }}]\
  {% if definicion.materia or definicion.institucion %}
  #v(2pt)
  #text(size: 1.1em, weight: "medium")[{{ [definicion.materia, definicion.institucion] | select | map("typst_texto") | join(" — ") }}]\
  {% endif %}
  #v(2pt)
  #text(size: 0.9em, fill: rgb("{{ c.sub }}"))[
    {% if definicion.fecha %}*Fecha:* {{ definicion.fecha | typst_texto }} | {% endif %}{% if definicion.duracion_minutos %}*Duración:* {{ definicion.duracion_minutos }} min | {% endif %}{% if omr %}*VARIANTE {{ omr.variante }}*{% else %}*TEMA {{ tema + 1 }}*{% endif %}
  ]
]

#v(6pt)

// Cuadro de Datos del Alumno
#rect(width: 100%, inset: 8pt, radius: 4pt, stroke: 0.8pt + rgb("{{ c.tenue }}"))[
  #grid(
    columns: (1.5fr, 1fr, 0.8fr),
    {% if omr %}[ *Apellido y Nombre:* {{ omr.nombre | typst_texto }} ],{% else %}[ *Apellido y Nombre:* #line(length: 65%, stroke: 0.5pt) ],{% endif %}
    [ *Legajo / DNI:* #line(length: 50%, stroke: 0.5pt) ],
    [ *Calificación:* #box(width: 30pt, height: 14pt, stroke: 0.5pt)[] ]
  )
]

{% if definicion.instrucciones_generales %}
#v(6pt)
#rect(width: 100%, fill: {% if definicion.configuracion_examen.debug_consignas %}none{% else %}rgb("{{ c.fondo_inst }}"){% endif %}, inset: 8pt, radius: 4pt, stroke: 0.5pt + rgb("{{ c.borde_inst }}"))[
  #text(weight: "bold", size: 0.9em)[Instrucciones Generales:]\
  #text(size: 0.85em)[{{ definicion.instrucciones_generales | typst_texto }}]
]
{% endif %}

#v(8pt)

// Secciones del Examen
{% set tipos_desarrollo = ['desarrollo', 'essay', 'codigo'] %}
{% set debug_consignas = {'titulo': 'nombre', 'id': 'id'}.get(definicion.configuracion_examen.debug_consignas) %}
{% set alto_desarrollo = {'chico': 6, 'mediano': 12, 'grande': 24} %}
{% for seccion in secciones %}
  {% if not loop.first and seccion.preguntas and seccion.preguntas[0].tamano_desarrollo == 'pagina' %}
  #pagebreak(weak: true)
  {% endif %}
  #text(size: 1.2em, weight: "bold", fill: rgb("{{ c.seccion }}"))[{{ seccion.nombre | typst_texto }}]
  {% if seccion.instrucciones %}
  \ #text(size: 0.85em, style: "italic", fill: rgb("{{ c.sub }}"))[{{ seccion.instrucciones | typst_texto }}]
  {% endif %}
  #v(4pt)

  {% for preg in seccion.preguntas %}
  {% set partes = preg.enunciado_html | typst_partes %}
  {% set hoja = preg.tamano_desarrollo == 'pagina' %}
  {% if hoja and not loop.first %}
  #pagebreak(weak: true)
  {% endif %}
  #pregunta-actual.update({{ preg.nombre | typst_cadena }})
  #pregunta(nombre: {{ preg.nombre | typst_cadena }}, libre: {{ 'true' if preg.tipo == 'consigna_practica' else 'false' }}, hoja: {{ 'true' if hoja else 'false' }}, (
    (false, grid(
      columns: (1fr, auto),
      column-gutter: 8pt,
      [ *Pregunta {{ loop.index }}.* {% if debug_consignas %}#text(size: 0.8em, fill: rgb("{{ c.sub }}"))[\[{{ preg[debug_consignas] | typst_texto }}\]] {% endif %}{{ partes[0].typst }} ],
      [ #text(size: 0.8em, fill: rgb("{{ c.tenue }}"))[\[{{ '%g' % preg.puntaje }} pt\]] ]
    )),
    {% for parte in partes[1:] %}
    ({{ 'true' if parte.marca else 'false' }}, [{{ parte.typst }}]),
    {% endfor %}
    (false, [
    {% if preg.tipo in ['seleccion_multiple', 'opcion_multiple', 'multichoice'] %}
    #v(4pt)
    {# Opciones cortas en varias columnas: 10 respuestas numéricas una por renglón ocupaban media página. #}
    {% set largo = preg.opciones | map(attribute="texto_html") | map("largo_visible") | max %}
    {% set por_fila = 5 if largo <= 12 else (2 if largo <= 40 else 1) %}
    #grid(
      columns: ({% for _ in range(por_fila) %}auto, 1fr, {% endfor %}),
      row-gutter: 5pt,
      column-gutter: 8pt,
      {% for op in preg.opciones %}
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("{{ c.sub }}"))[] *{{ letra(loop.index0) }})* ],
      [ {{ op.texto_html | typst }} ],
      {% endfor %}
    )
    {% if preg.lineas_justificacion %}
    #v(6pt)
    #text(size: 0.85em, weight: "bold", fill: rgb("{{ c.sub }}"))[{{ (definicion.configuracion_examen.titulo_justificacion or i18n.justification or 'Justificación') | typst_texto }}]
    #block(width: 100%, stroke: 0.5pt + rgb("{{ c.guia }}"), radius: 3pt, inset: (x: 6pt), above: 3pt)[
      {% for _ in range(preg.lineas_justificacion) %}#block(width: 100%, height: 16pt, below: 0pt, stroke: (bottom: (dash: "dotted", paint: rgb("{{ c.guia }}"), thickness: 0.5pt)))[]
      {% endfor %}
    ]
    {% endif %}
    {% elif preg.tipo in ['verdadero_falso', 'truefalse'] %}
    #v(4pt)
    #grid(
      columns: (auto, 1fr, auto, 1fr),
      column-gutter: 12pt,
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("{{ c.sub }}"))[] ], [ Verdadero ],
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("{{ c.sub }}"))[] ], [ Falso ]
    )
    {% elif preg.tipo == 'consigna_practica' %}
    {% if preg.lineas_respuesta %}
    #v(6pt)
    #block(width: 100%, stroke: 0.5pt + rgb("{{ c.guia }}"), radius: 3pt, inset: (x: 6pt), breakable: true)[
      {% for _ in range(preg.lineas_respuesta) %}#block(width: 100%, height: 16pt, below: 0pt, stroke: (bottom: (dash: "dotted", paint: rgb("{{ c.guia }}"), thickness: 0.5pt)))[]
      {% endfor %}
    ]
    {% endif %}
    {% elif preg.tipo in tipos_desarrollo and not hoja and preg.tamano_desarrollo != 'cero' %}
    #v(6pt)
    #context espacio({{ alto_desarrollo[preg.tamano_desarrollo or 'mediano'] }}em.to-absolute())
    {% endif %}
    ]),
  ))
  #v(6pt)
  {% if hoja and not loop.last %}
  #pagebreak(weak: true)
  {% endif %}
  {% endfor %}
#v(8pt)
{% endfor %}
