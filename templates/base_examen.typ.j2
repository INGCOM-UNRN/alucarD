// Plantilla Typst para Examen Teórico (alucarD)
#set document(title: "{{ definicion.nombre_examen }} - Tema {{ tema + 1 }}", author: "{{ definicion.institucion }}")
#set page(
  paper: "a4",
  margin: (top: {{ estilo.margen_sup_mm }}mm, bottom: 2cm, left: 2cm, right: 2cm),
  header: context [
    {% if estilo.logo_typst %}#let logo = {{ estilo.logo_typst }}
    {% endif %}#{{ estilo.encabezado_typst }}
  ],
  footer: context [
    #line(length: 100%, stroke: 0.5pt + rgb("{{ c.linea_pie }}"))
    #{{ estilo.pie_typst }}
  ]
)

#set text(font: {{ estilo.fuente_typst }}, size: {{ estilo.tamano }}pt, lang: "{{ definicion.idioma | default('es') }}"{% if estilo.alto_contraste %}, fill: black{% endif %})
#show raw: set text(font: {{ estilo.fuente_codigo_typst }})
{% if estilo.alto_contraste %}
// Alto contraste: el código, sin el gris de los comentarios del resaltado
#show raw: set text(fill: black)
#set raw(theme: none)
{% endif %}
#set par(justify: true, leading: 0.65em)

// Encabezado del Examen
#align(center)[
  #text(size: 16pt, weight: "bold", fill: rgb("{{ c.titulo }}"))[{{ definicion.nombre_examen | typst_texto }}]\
  {% if definicion.materia or definicion.institucion %}
  #v(2pt)
  #text(size: 11pt, weight: "medium")[{{ [definicion.materia, definicion.institucion] | select | map("typst_texto") | join(" — ") }}]\
  {% endif %}
  #v(2pt)
  #text(size: 9pt, fill: rgb("{{ c.sub }}"))[
    {% if definicion.fecha %}*Fecha:* {{ definicion.fecha | typst_texto }} | {% endif %}{% if definicion.duracion_minutos %}*Duración:* {{ definicion.duracion_minutos }} min | {% endif %}*TEMA {{ tema + 1 }}*
  ]
]

#v(6pt)

// Cuadro de Datos del Alumno
#rect(width: 100%, inset: 8pt, radius: 4pt, stroke: 0.8pt + rgb("{{ c.tenue }}"))[
  #grid(
    columns: (1.5fr, 1fr, 0.8fr),
    [ *Apellido y Nombre:* #line(length: 65%, stroke: 0.5pt) ],
    [ *Padrón / DNI:* #line(length: 50%, stroke: 0.5pt) ],
    [ *Calificación:* #box(width: 30pt, height: 14pt, stroke: 0.5pt)[] ]
  )
]

{% if definicion.instrucciones_generales %}
#v(6pt)
#rect(width: 100%, fill: rgb("{{ c.fondo_inst }}"), inset: 8pt, radius: 4pt, stroke: 0.5pt + rgb("{{ c.borde_inst }}"))[
  #text(weight: "bold", size: 9pt)[Instrucciones Generales:]\
  #text(size: 8.5pt)[{{ definicion.instrucciones_generales | typst_texto }}]
]
{% endif %}

#v(8pt)

// Secciones del Examen
{% for seccion in secciones %}
#block(breakable: true)[
  #text(size: 12pt, weight: "bold", fill: rgb("{{ c.seccion }}"))[{{ seccion.nombre | typst_texto }}]
  {% if seccion.instrucciones %}
  \ #text(size: 8.5pt, style: "italic", fill: rgb("{{ c.sub }}"))[{{ seccion.instrucciones | typst_texto }}]
  {% endif %}
  #v(4pt)

  {% for preg in seccion.preguntas %}
  #block(
    width: 100%,
    stroke: 0.5pt + rgb("{{ c.borde }}"),
    radius: 4pt,
    inset: 8pt,
    fill: rgb("ffffff"),
    breakable: {{ 'true' if preg.tipo == 'consigna_practica' else 'false' }}
  )[
    #grid(
      columns: (1fr, auto),
      column-gutter: 8pt,
      [ *Pregunta {{ loop.index }}.* {{ preg.enunciado_html | typst }} ],
      [ #text(size: 8pt, fill: rgb("{{ c.tenue }}"))[\[{{ '%g' % preg.puntaje }} pt\]] ]
    )

    {% if preg.tipo in ['seleccion_multiple', 'opcion_multiple', 'multichoice'] %}
    #v(4pt)
    {# Opciones cortas en varias columnas: 10 respuestas numéricas una por renglón ocupaban media página. #}
    {% set largo = preg.opciones | map(attribute="texto_html") | map("largo_visible") | max %}
    {% set por_fila = 5 if largo <= 12 else (2 if largo <= 40 else 1) %}
    #grid(
      columns: ({% for _ in range(por_fila) %}auto, 1fr, {% endfor %}),
      row-gutter: 5pt,
      column-gutter: 8pt,
      {% for op in preg.opciones %}
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("{{ c.sub }}"))[] *{{ letra(loop.index0) }})* ],
      [ {{ op.texto_html | typst }} ],
      {% endfor %}
    )
    {% if preg.lineas_justificacion %}
    #v(6pt)
    #text(size: 8.5pt, weight: "bold", fill: rgb("{{ c.sub }}"))[{{ (definicion.configuracion_examen.titulo_justificacion or i18n.justification or 'Justificación') | typst_texto }}]
    #block(width: 100%, stroke: 0.5pt + rgb("{{ c.guia }}"), radius: 3pt, inset: (x: 6pt), above: 3pt)[
      {% for _ in range(preg.lineas_justificacion) %}#block(width: 100%, height: 16pt, below: 0pt, stroke: (bottom: (dash: "dotted", paint: rgb("{{ c.guia }}"), thickness: 0.5pt)))[]
      {% endfor %}
    ]
    {% endif %}
    {% elif preg.tipo in ['verdadero_falso', 'truefalse'] %}
    #v(4pt)
    #grid(
      columns: (auto, 1fr, auto, 1fr),
      column-gutter: 12pt,
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("{{ c.sub }}"))[] ], [ Verdadero ],
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("{{ c.sub }}"))[] ], [ Falso ]
    )
    {% elif preg.tipo == 'consigna_practica' %}
    {% if preg.lineas_respuesta %}
    #v(6pt)
    #block(width: 100%, stroke: 0.5pt + rgb("{{ c.guia }}"), radius: 3pt, inset: (x: 6pt), breakable: true)[
      {% for _ in range(preg.lineas_respuesta) %}#block(width: 100%, height: 16pt, below: 0pt, stroke: (bottom: (dash: "dotted", paint: rgb("{{ c.guia }}"), thickness: 0.5pt)))[]
      {% endfor %}
    ]
    {% endif %}
    {% elif preg.tipo in ['desarrollo', 'essay', 'codigo'] %}
    #v(6pt)
    #rect(width: 100%, height: 60pt, stroke: (dash: "densely-dotted", paint: rgb("{{ c.guia }}"), thickness: 0.5pt))[
      #align(bottom + right)[#text(size: 7.5pt, fill: rgb("{{ c.guia }}"))[Espacio para desarrollo / código]]
    ]
    {% endif %}
  ]
  #v(6pt)
  {% endfor %}
]
#v(8pt)
{% endfor %}
