// Plantilla Typst para Examen Teórico (alucarD)
#set document(title: "{{ definicion.nombre_examen }} - Tema {{ tema + 1 }}", author: "{{ definicion.institucion }}")
#set page(
  paper: "a4",
  margin: (top: 2cm, bottom: 2cm, left: 2cm, right: 2cm),
  header: align(right)[
    #text(size: 8pt, fill: rgb("666666"))[{{ definicion.institucion }} — {{ definicion.materia }} | *Tema {{ tema + 1 }}*]
  ],
  footer: context [
    #line(length: 100%, stroke: 0.5pt + rgb("cccccc"))
    #grid(
      columns: (1fr, 1fr),
      align(left)[#text(size: 8pt, fill: rgb("888888"))[{{ definicion.nombre_examen }}]],
      align(right)[#text(size: 8pt, fill: rgb("888888"))[Página #counter(page).display("1 / 1", both: true)]]
    )
  ]
)

#set text(font: ("Liberation Sans", "DejaVu Sans", "Arial"), size: 10pt, lang: "{{ definicion.idioma | default('es') }}")
#set par(justify: true, leading: 0.65em)

// Encabezado del Examen
#align(center)[
  #text(size: 16pt, weight: "bold", fill: rgb("1b365d"))[{{ definicion.nombre_examen }}]\
  #v(2pt)
  #text(size: 11pt, weight: "medium")[*{{ definicion.materia }}* — {{ definicion.institucion }}]\
  #v(2pt)
  #text(size: 9pt, fill: rgb("4a5568"))[
    *Fecha:* {{ definicion.fecha }} | *Duración:* {{ definicion.duracion_minutos }} min | *TEMA {{ tema + 1 }}*
  ]
]

#v(6pt)

// Cuadro de Datos del Alumno
#rect(width: 100%, inset: 8pt, radius: 4pt, stroke: 0.8pt + rgb("718096"))[
  #grid(
    columns: (1.5fr, 1fr, 0.8fr),
    [ *Apellido y Nombre:* #line(length: 65%, stroke: 0.5pt) ],
    [ *Padrón / DNI:* #line(length: 50%, stroke: 0.5pt) ],
    [ *Calificación:* #box(width: 30pt, height: 14pt, stroke: 0.5pt)[] ]
  )
]

{% if definicion.instrucciones_generales %}
#v(6pt)
#rect(width: 100%, fill: rgb("f7fafc"), inset: 8pt, radius: 4pt, stroke: 0.5pt + rgb("cbd5e0"))[
  #text(weight: "bold", size: 9pt)[Instrucciones Generales:]\
  #text(size: 8.5pt)[{{ definicion.instrucciones_generales }}]
]
{% endif %}

#v(8pt)

// Secciones del Examen
{% for seccion in secciones %}
#block(breakable: true)[
  #text(size: 12pt, weight: "bold", fill: rgb("2b6cb0"))[{{ seccion.nombre }}]
  {% if seccion.instrucciones %}
  \ #text(size: 8.5pt, style: "italic", fill: rgb("4a5568"))[{{ seccion.instrucciones }}]
  {% endif %}
  #v(4pt)

  {% for preg in seccion.preguntas %}
  #block(
    width: 100%,
    stroke: 0.5pt + rgb("e2e8f0"),
    radius: 4pt,
    inset: 8pt,
    fill: rgb("ffffff"),
    breakable: false
  )[
    #grid(
      columns: (1fr, auto),
      [ *Pregunta {{ loop.index }}:* {{ preg.enunciado | default(preg.titulo) }} ],
      [ #text(size: 8pt, fill: rgb("718096"))[[{{ preg.puntos | default(1) }} pt]] ]
    )

    {% if preg.tipo in ['seleccion_multiple', 'opcion_multiple', 'multichoice'] %}
    #v(4pt)
    #grid(
      columns: (auto, 1fr),
      row-gutter: 5pt,
      column-gutter: 8pt,
      {% for op in preg.opciones %}
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("4a5568"))[] ],
      [ {{ op.texto | default(op) }} ],
      {% endfor %}
    )
    {% elif preg.tipo in ['verdadero_falso', 'truefalse'] %}
    #v(4pt)
    #grid(
      columns: (auto, 1fr, auto, 1fr),
      column-gutter: 12pt,
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("4a5568"))[] ], [ Verdadero ],
      [ #box(width: 10pt, height: 10pt, radius: 2pt, stroke: 0.8pt + rgb("4a5568"))[] ], [ Falso ]
    )
    {% elif preg.tipo in ['desarrollo', 'essay', 'codigo'] %}
    #v(6pt)
    #rect(width: 100%, height: 60pt, stroke: (dash: "densely-dotted", paint: rgb("a0aec0"), thickness: 0.5pt))[
      #align(bottom + right)[#text(size: 7.5pt, fill: rgb("a0aec0"))[Espacio para desarrollo / código]]
    ]
    {% endif %}
  ]
  #v(6pt)
  {% endfor %}
]
#v(8pt)
{% endfor %}
