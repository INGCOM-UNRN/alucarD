<!DOCTYPE html>
<html lang="{{ definicion.idioma }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ definicion.nombre_examen }}</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 2cm;
            line-height: 1.6;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #333;
            padding-bottom: 1em;
            margin-bottom: 1.5em;
        }
        .header h1 {
            margin: 0.2em 0;
            font-size: 1.8em;
        }
        .header .info {
            margin: 0.3em 0;
            font-size: 0.95em;
        }
        .student-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1.5em;
            padding: 0.5em;
            border: 1px solid #ccc;
        }
        .instructions {
            background-color: #f5f5f5;
            padding: 1em;
            margin-bottom: 1.5em;
            border-left: 4px solid #333;
        }
        .section {
            page-break-inside: avoid;
            margin-bottom: 2em;
        }
        .section-title {
            background-color: #333;
            color: white;
            padding: 0.5em;
            margin-bottom: 1em;
            font-size: 1.2em;
        }
        .question {
            margin-bottom: 1.5em;
            page-break-inside: avoid;
        }
        .question-header {
            font-weight: bold;
            margin-bottom: 0.5em;
        }
        .question-text {
            margin-bottom: 0.8em;
        }
        .options {
            margin-left: 1.5em;
        }
        .option {
            margin-bottom: 0.4em;
        }
        .answer-space {
            border-bottom: 1px solid #ccc;
            min-height: 3em;
            margin-top: 0.5em;
        }
        @media print {
            body {
                margin: 1.5cm;
            }
            .section {
                page-break-before: always;
            }
            .section:first-of-type {
                page-break-before: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ definicion.nombre_examen }}</h1>
        <div class="info"><strong>{{ i18n.institution }}:</strong> {{ definicion.institucion }}</div>
        <div class="info"><strong>{{ i18n.subject }}:</strong> {{ definicion.materia }}</div>
        {% if definicion.fecha %}
        <div class="info"><strong>{{ i18n.date }}:</strong> {{ definicion.fecha }}</div>
        {% endif %}
        {% if definicion.duracion_minutos %}
        <div class="info"><strong>{{ i18n.duration }}:</strong> {{ definicion.duracion_minutos }} {{ i18n.minutes }}</div>
        {% endif %}
        <div class="info"><strong>{{ i18n.topic }}:</strong> {{ tema + 1 }}</div>
    </div>

    <div class="student-info">
        <div><strong>{{ i18n.student_name }}:</strong> _______________________________</div>
        <div><strong>{{ i18n.student_id }}:</strong> _______________________________</div>
    </div>

    {% if definicion.instrucciones_generales %}
    <div class="instructions">
        <strong>{{ i18n.general_instructions }}:</strong>
        <div>{{ definicion.instrucciones_generales }}</div>
    </div>
    {% endif %}

    {% for seccion in secciones %}
    <div class="section">
        <div class="section-title">{{ i18n.section }}: {{ seccion.nombre }}</div>
        
        {% if seccion.instrucciones %}
        <div class="instructions">
            <strong>{{ i18n.instructions }}:</strong> {{ seccion.instrucciones }}
        </div>
        {% endif %}

        {% for pregunta in seccion.preguntas %}
        <div class="question">
            <div class="question-header">
                {{ i18n.question }} {{ loop.index }} 
                ({{ pregunta.puntaje }} {% if pregunta.puntaje == 1 %}{{ i18n.point }}{% else %}{{ i18n.points }}{% endif %})
            </div>
            <div class="question-text">{{ pregunta.enunciado_html | safe }}</div>
            
            {% if pregunta.tipo == 'seleccion_multiple' %}
            <div class="options">
                {% for opcion in pregunta.opciones %}
                <div class="option">
                    <input type="radio" name="q{{ pregunta.id }}" disabled> {{ opcion.texto_html | safe }}
                </div>
                {% endfor %}
            </div>
            {% elif pregunta.tipo == 'verdadero_falso' %}
            <div class="options">
                <div class="option"><input type="radio" name="q{{ pregunta.id }}" disabled> Verdadero</div>
                <div class="option"><input type="radio" name="q{{ pregunta.id }}" disabled> Falso</div>
            </div>
            {% else %}
            <div class="answer-space"></div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endfor %}
</body>
</html>
