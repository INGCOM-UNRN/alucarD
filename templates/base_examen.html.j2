<!DOCTYPE html>
<html lang="{{ definicion.idioma }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ definicion.nombre_examen }}</title>
    <style>
/* CSS Refactorizado para el Cuestionario
  - Se ha establecido el layout de CSS Grid como el predeterminado.
  - Se han eliminado reglas duplicadas y contradictorias.
*/

body {
  font-family: 'Arial', sans-serif;
  margin: 2cm;
  line-height: 1.6;
}

/* --- Encabezado y Meta-Info --- */

.header {
  text-align: center;
  border-bottom: 2px solid #333;
  padding-bottom: 1em;
  margin-bottom: 1.5em;
}

.header h1 {
  margin: 0.2em 0;
  font-size: 1.8em;
}

.header .info {
  margin: 0.3em 0;
  font-size: 0.95em;
}

.student-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 1.5em;
  padding: 0.5em;
  border: 1px solid #ccc;
}

.instructions {
  background-color: #f5f5f5;
  padding: 1em;
  margin-bottom: 1.5em;
  border-left: 4px solid #333;
}

/* --- Secciones --- */

.section {
  page-break-inside: avoid;
  margin-bottom: 2em;
}

.section-title {
  background-color: #333;
  color: white;
  padding: 0.5em;
  margin-bottom: 1em;
  font-size: 1.2em;
}

/* --- Bloque de Pregunta (Layout Default - Análisis de Código) --- */

.question {
  display: grid;
  /* Define 2 columnas: 2/3 para pregunta, 1/3 para opciones */
  grid-template-columns: 2fr 1fr;
  gap: 20px; /* Espacio entre la pregunta y las opciones */
  
  margin-bottom: 1.5em;
  page-break-inside: avoid;

  border: 1px solid #555; /* Borde gris oscuro para agrupar */
  padding: 1em;            /* Espaciado interno */
  border-radius: 5px;      /* Esquinas redondeadas (opcional) */
}

.question-header {
  font-weight: bold;
  margin-bottom: 0.5em;
  grid-column: 1; /* Coloca en la primera columna */
  grid-row: 1;    /* Coloca en la primera fila */
}

.question-text {
  margin-bottom: 0.8em;
  grid-column: 1; /* Coloca en la primera columna */
  grid-row: 2;    /* Coloca en la segunda fila */
}

/* --- Layout Compacto 2 Columnas --- */

.section.layout-compact-2col .question {
  display: block; /* Cambiar a layout de bloque */
  padding: 0.5em;
  margin-bottom: 1em;
}

.section.layout-compact-2col .question-header {
  /* Ya no usa grid */
}

.section.layout-compact-2col .question-text {
  margin-bottom: 0.5em;
}

.section.layout-compact-2col .options {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 2 columnas */
  gap: 0.3em;
  margin-top: 0.5em;
  /* Resetear propiedades del layout default */
  grid-column: auto;
  grid-row: auto;
}

.section.layout-compact-2col .option {
  margin-bottom: 0.2em;
  break-inside: avoid;
}

/* --- Layout Compacto 3 Columnas --- */

.section.layout-compact-3col .question {
  display: block; /* Cambiar a layout de bloque */
  padding: 0.5em;
  margin-bottom: 0.8em;
}

.section.layout-compact-3col .question-header {
  font-size: 0.95em;
}

.section.layout-compact-3col .question-text {
  margin-bottom: 0.4em;
  font-size: 0.95em;
}

.section.layout-compact-3col .options {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr; /* 3 columnas */
  gap: 0.2em;
  margin-top: 0.4em;
  /* Resetear propiedades del layout default */
  grid-column: auto;
  grid-row: auto;
}

.section.layout-compact-3col .option {
  margin-bottom: 0.1em;
  break-inside: avoid;
  font-size: 0.9em;
}

/* --- Layout Compact 4 Columnas --- */

.section.layout-compact-4col .question {
  display: block;
  padding: 0.5em;
  margin-bottom: 0.8em;
}

.section.layout-compact-4col .question-header {
  font-size: 0.95em;
}

.section.layout-compact-4col .question-text {
  margin-bottom: 0.4em;
  font-size: 0.95em;
}

.section.layout-compact-4col .options {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr; /* 4 columnas */
  gap: 0.15em;
  margin-top: 0.4em;
  /* Resetear propiedades del layout default */
  grid-column: auto;
  grid-row: auto;
}

.section.layout-compact-4col .option {
  margin-bottom: 0.1em;
  break-inside: avoid;
  font-size: 0.85em;
}

.options {
  /* El 'margin-left: 1.5em' anterior ya no es necesario.
    El 'gap' del grid .question se encarga del espaciado.
  */
  grid-column: 2;   /* Coloca en la segunda columna */
  grid-row: 1 / 3;  /* Ocupa las filas 1 y 2 */
  align-self: start;
}

/* --- Ítems de Opción (Layout con Flexbox) --- */

.option {
  display: flex;
  align-items: center; /* Alinea verticalmente el checkbox, label y texto */
  gap: 0.5em;
  margin-bottom: 0.4em;
  /* Se eliminó 'align-items: flex-start' que estaba duplicado */
}

.option-checkbox {
  width: 1em;
  height: 1em;
  border: 2px solid #333;
  background-color: white;
  flex-shrink: 0;
  /* Se eliminó 'margin-top: 0.2em'
    'align-items: center' en .option ya lo centra verticalmente.
  */
}

.option-label {
  font-weight: bold;
  margin-right: 0.3em;
  flex-shrink: 0;
}

.option-text {
  flex: 1;
}

/* --- Otros Elementos --- */

.answer-space {
  border-bottom: 1px solid #ccc;
  min-height: 3em;
  margin-top: 0.5em;
}

/* --- Estilos para Preguntas de Desarrollo --- */

.desarrollo-box {
  border: 1px solid #666;
  border-radius: 3px;
  padding: 0.5em;
  margin-top: 0.5em;
  background-color: #fafafa;
  display: flex;
  flex-direction: column;
}

.desarrollo-box.pequeno {
  min-height: 4em;
}

.desarrollo-box.mediano {
  min-height: 8em;
}

.desarrollo-box.grande {
  min-height: 14em;
}

/* En layouts compactos, las preguntas de desarrollo ocupan todo el ancho */
.section.layout-compact-2col .desarrollo-box,
.section.layout-compact-3col .desarrollo-box,
.section.layout-compact-4col .desarrollo-box {
  min-height: 6em;
}

.section.layout-compact-2col .desarrollo-box.mediano,
.section.layout-compact-3col .desarrollo-box.mediano,
.section.layout-compact-4col .desarrollo-box.mediano {
  min-height: 8em;
}

.section.layout-compact-2col .desarrollo-box.grande,
.section.layout-compact-3col .desarrollo-box.grande,
.section.layout-compact-4col .desarrollo-box.grande {
  min-height: 12em;
}

/* --- Estilos para Bloques de Código --- */

.highlight {
  background-color: #f8f8f8;
  border: 1px solid #ddd;
  border-radius: 3px;
  padding: 0.8em;
  overflow-x: auto;
  margin: 0.5em 0;
  font-family: 'Courier New', monospace;
  font-size: 0.9em;
  line-height: 1.4;
}

pre {
  margin: 0;
  white-space: pre-wrap;
  word-wrap: break-word;
}

code {
  font-family: 'Courier New', monospace;
  font-size: 0.9em;
}

/* --- Estilos Específicos para Impresión --- */

@media print {
  body {
    margin: 1.5cm;
  }

  .section {
    page-break-before: always;
  }

  .section:first-of-type {
    page-break-before: avoid;
  }
  
  /* --- Optimización para layouts compactos en impresión --- */
  
  .section.layout-compact-2col .question,
  .section.layout-compact-3col .question,
  .section.layout-compact-4col .question {
    padding: 0.3em;
    margin-bottom: 0.5em;
    border-width: 0.5px;
  }
  
  .section.layout-compact-2col .question-text,
  .section.layout-compact-3col .question-text,
  .section.layout-compact-4col .question-text {
    margin-bottom: 0.3em;
    line-height: 1.3;
  }
  
  .section.layout-compact-2col .options {
    gap: 0.2em;
  }
  
  .section.layout-compact-3col .options {
    gap: 0.15em;
  }
  
  .section.layout-compact-4col .options {
    gap: 0.1em;
  }
  
  .section.layout-compact-2col .option,
  .section.layout-compact-3col .option,
  .section.layout-compact-4col .option {
    margin-bottom: 0.1em;
    font-size: 0.85em;
    line-height: 1.2;
  }
  
  /* Reducir espacio en headers para layouts compactos */
  .section.layout-compact-2col .question-header,
  .section.layout-compact-3col .question-header,
  .section.layout-compact-4col .question-header {
    margin-bottom: 0.2em;
  }
  
  /* Reducir tamaño de checkbox en layouts compactos */
  .section.layout-compact-2col .option-checkbox,
  .section.layout-compact-3col .option-checkbox,
  .section.layout-compact-4col .option-checkbox {
    width: 10px;
    height: 10px;
    min-width: 10px;
  }
  
  /* Optimización de preguntas de desarrollo en impresión */
  .desarrollo-box {
    padding: 0.3em !important;
    background-color: white !important;
    border: 1px solid #666 !important;
  }
  
  .desarrollo-box.pequeno {
    min-height: 3em !important;
  }
  
  .desarrollo-box.mediano {
    min-height: 6em !important;
  }
  
  .desarrollo-box.grande {
    min-height: 10em !important;
  }
  
  /* Simplificar bloques de código para impresión */
  .highlight {
    background-color: #f9f9f9 !important;
    border: 1px solid #333 !important;
    border-radius: 0 !important;
    padding: 0.4em !important;
    font-size: 0.8em !important;
    page-break-inside: avoid;
    line-height: 1.3 !important;
  }
  
  /* Remover colores de sintaxis y usar tonos de gris */
  .highlight * {
    background-color: transparent !important;
    color: #000 !important;
    font-weight: normal !important;
  }
  
  /* Mantener estructura pero sin colores */
  .highlight pre {
    margin: 0 !important;
    padding: 0 !important;
    white-space: pre-wrap !important;
    word-wrap: break-word !important;
  }
  
  /* Asegurar que el código sea legible y compacto */
  code {
    font-family: 'Courier New', 'Courier', monospace !important;
    font-size: 0.8em !important;
    color: #000 !important;
    line-height: 1.2 !important;
  }
  
  /* Reducir márgenes de párrafos dentro del código */
  .highlight p {
    margin: 0.2em 0 !important;
  }
}


    </style>
</head>
<body>
    <div class="header">
        <h1>{{ definicion.nombre_examen }}</h1>
        <div class="info"><strong>{{ i18n.institution }}:</strong> {{ definicion.institucion }}</div>
        <div class="info"><strong>{{ i18n.subject }}:</strong> {{ definicion.materia }}</div>
        {% if definicion.fecha %}
        <div class="info"><strong>{{ i18n.date }}:</strong> {{ definicion.fecha }}</div>
        {% endif %}
        {% if definicion.duracion_minutos %}
        <div class="info"><strong>{{ i18n.duration }}:</strong> {{ definicion.duracion_minutos }} {{ i18n.minutes }}</div>
        {% endif %}
        <div class="info"><strong>{{ i18n.topic }}:</strong> {{ tema + 1 }}</div>
        
        {# Variables personalizadas disponibles #}
        {% if variables and variables.get('profesor') %}
        <div class="info"><strong>Profesor:</strong> {{ variables.profesor }}</div>
        {% endif %}
        {% if variables and variables.get('aula') %}
        <div class="info"><strong>Aula:</strong> {{ variables.aula }}</div>
        {% endif %}
    </div>

    <div class="student-info">
        <div><strong>{{ i18n.student_name }}:</strong> _______________________________</div>
        <div><strong>{{ i18n.student_id }}:</strong> _______________________________</div>
    </div>

    {% if definicion.instrucciones_generales %}
    <div class="instructions">
        <strong>{{ i18n.general_instructions }}:</strong>
        <div>{{ definicion.instrucciones_generales }}</div>
    </div>
    {% endif %}

    {% for seccion in secciones %}
    <div class="section{% if seccion.layout %} layout-{{ seccion.layout }}{% endif %}">
        <div class="section-title">{{ i18n.section }}: {{ seccion.nombre }}</div>
        
        {% if seccion.instrucciones %}
        <div class="instructions">
            <strong>{{ i18n.instructions }}:</strong> {{ seccion.instrucciones }}
        </div>
        {% endif %}

        {% for pregunta in seccion.preguntas %}
        <div class="question">
            <div class="question-header">
                {{ i18n.question }} {{ loop.index }} 
                ({{ pregunta.puntaje }} {% if pregunta.puntaje == 1 %}{{ i18n.point }}{% else %}{{ i18n.points }}{% endif %})
            </div>
            <div class="question-text">{{ pregunta.enunciado_html | safe }}</div>
            
            {% if pregunta.tipo == 'seleccion_multiple' %}
            <div class="options">
                {% set letras = 'abcdefghijklmnopqrstuvwxyz' %}
                {% for opcion in pregunta.opciones %}
                <div class="option">
                    <div class="option-checkbox"></div>
                    <span class="option-label">{{ letras[loop.index0] }})</span>
                    <div class="option-text">{{ opcion.texto_html | safe }}</div>
                </div>
                {% endfor %}
            </div>
            {% elif pregunta.tipo == 'verdadero_falso' %}
            <div class="options">
                <div class="option">
                    <div class="option-checkbox"></div>
                    <span class="option-label">V)</span>
                    <div class="option-text">Verdadero</div>
                </div>
                <div class="option">
                    <div class="option-checkbox"></div>
                    <span class="option-label">F)</span>
                    <div class="option-text">Falso</div>
                </div>
            </div>
            {% elif pregunta.tipo == 'desarrollo' %}
            <div class="desarrollo-box {{ pregunta.tamano_desarrollo or 'mediano' }}">
            </div>
            {% else %}
            <div class="answer-space"></div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endfor %}
</body>
</html>
